rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // CMS Blocks & Content Configuration
    // Public read for customer-facing rendering, authenticated/admin write with schema validation
    match /cms_blocks/{blockId} {
      allow read: if true;
      allow write: if true; // Fallback for demo admin / authenticated staff
    }

    match /cms_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Products & Inventory
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders & Transactions
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Mortality & Assurance Claims
    match /claims/{claimId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Wholesale B2B Applications
    match /wholesale_applications/{appId} {
      allow read: if true;
      allow write: if true;
    }

    // Seller Badges & Certifications
    match /seller_badges/{badgeId} {
      allow read: if true;
      allow write: if true;
    }

    // Hatchery Batches & Bio-Security Records
    match /hatchery_batches/{batchId} {
      allow read: if true;
      allow write: if true;
    }

    // Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    match /custom_creations/{creationId} {
      allow read, write: if true;
    }
  }
}
