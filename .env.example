# ==========================================
# CHICKMAGNET - ENVIRONMENT CONFIGURATION
# ==========================================

# Port and server environment
PORT=3000
NODE_ENV=development

# Frontend integration URL
FRONTEND_URL=http://localhost:3000

# Primary transactional Database: PostgreSQL 16
DATABASE_URL=postgresql://chickmagnet_user:chickmagnet_password@localhost:5432/chickmagnet?schema=public

# High-performance caching & message queues: Redis 7
REDIS_URL=redis://localhost:6379

# JWT Asymmetric Signing Credentials (RS256 Private/Public key pair)
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
REFRESH_TOKEN_SECRET=your_long_refresh_token_secret_here

# Payment gateway integration: Stripe & Stripe Connect
STRIPE_SECRET_KEY=sk_test_your_secret_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_CONNECT_CLIENT_ID=ca_your_stripe_connect_client_id_here

# S3-compatible cloud storage: Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET=chickmagnet-bucket

# Transactional emails: Resend
RESEND_API_KEY=re_your_resend_api_key_here

# Mobile messages (Kenyan market): Africa's Talking
AFRICAS_TALKING_API_KEY=at_your_africas_talking_api_key_here
AFRICAS_TALKING_USERNAME=sandbox

# Third-party OAuth Providers
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
APPLE_CLIENT_ID=your_apple_client_id_here
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Web Push Notifications Credentials
WEBPUSH_PUBLIC_KEY=your_webpush_public_key_here
WEBPUSH_PRIVATE_KEY=your_webpush_private_key_here
