{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "scripts": {
    "dev": "react-router dev --host 0.0.0.0 --port 3000",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/nodejs_*/index.js",
    "build:legacy-server": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start:legacy-server": "node dist/server.cjs",
    "clean": "rm -rf build dist dist-server server.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "npm run typecheck",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:server-contracts": "tsx scripts/verify-server-contracts.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/client": "~6.12.0",
    "@react-router/node": "7.18.4",
    "@react-router/serve": "7.18.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.16.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "isbot": "5.1.30",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.9.1",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router": "7.18.4",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.4",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/react-router": "1.3.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "nodemon": "^3.1.14",
    "prisma": "~6.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
