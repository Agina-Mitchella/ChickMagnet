{
  "entities": {
    "CMSBlock": {
      "title": "Brand setting",
      "description": "An editable ChickMagnet name or logo setting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "pageId": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "string" },
        "lastEditedBy": { "type": "string" },
        "lastEditedAt": { "type": "string" }
      },
      "required": ["id", "pageId", "value"]
    },
    "Product": {
      "title": "Product",
      "description": "A ChickMagnet chicken or egg listing and its storefront content",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "stock": { "type": "number" },
        "catalogStatus": { "type": "string" },
        "showOnStorefront": { "type": "boolean" }
      },
      "required": ["id", "name", "description", "price", "category", "catalogStatus"]
    },
    "Order": {
      "title": "Customer order",
      "description": "A submitted order with manual M-Pesa and price review state",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "customerName": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentConfirmationStatus": { "type": "string" },
        "pricingVerificationStatus": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "buyerId",
        "customerName",
        "total",
        "status",
        "paymentConfirmationStatus",
        "pricingVerificationStatus",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/cms_blocks/{blockId}": {
      "schema": { "$ref": "#/entities/CMSBlock" },
      "description": "ChickMagnet name and logo settings"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Published, unavailable, and archived storefront products"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders and fulfilment state"
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "type": "object" },
      "description": "Append-only record of administrator changes"
    },
    "/users/{userId}": {
      "schema": { "type": "object" },
      "description": "Customer account profiles"
    }
  }
}
